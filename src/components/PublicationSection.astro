<section class="section publications" id="publications">
  <div class="container">
    <div class="publication-heading">
      <div>
        <span class="section-label">RESEARCH & PUBLICATIONS</span>
        <h2 class="section-title">Research Publications</h2>
        <p class="section-description">
          Research contributions in Artificial Intelligence, Deep Learning,
          Computer Vision, Medical Imaging and Intelligent Systems.
        </p>
      </div>

      <span class="publication-count">
        {publications.length} PUBLICATIONS
      </span>
    </div>

    <div class="publication-list">
      {publications.map((paper) => (
        <article class="publication-card">
          <div class="publication-top">
            <span class="publication-year">{paper.year}</span>

            <a
              class="doi-link"
              href={`https://doi.org/${paper.doi}`}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`View DOI for ${paper.title}`}
            >
              DOI ↗
            </a>
          </div>

          <h3>{paper.title}</h3>

          <div class="publisher-row">
            {publisherDomains[paper.publisher] ? (
              <img
                class="publisher-logo"
                src={`https://www.google.com/s2/favicons?domain=${publisherDomains[paper.publisher]}&sz=128`}
                alt={`${paper.publisher} logo`}
                title={paper.publisher}
                loading="lazy"
              />
            ) : (
              <span class="publisher-fallback">{paper.publisher}</span>
            )}

            <span class="publisher-name">{paper.publisher}</span>
          </div>

          <div class="publication-meta">
            <span class="type-badge">{paper.type}</span>

            {paper.quartile && (
              <span class="quartile-badge">{paper.quartile}</span>
            )}

            {paper.snip && (
              <span class="snip-badge">SNIP {paper.snip}</span>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .publications {
    background: #f8fafc;
  }

  .publication-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 32px;
  }

  .publication-count {
    flex-shrink: 0;
    padding: 8px 12px;
    border: 1px solid #c7d2fe;
    border-radius: 8px;
    background: #eef2ff;
    color: #4338ca;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .6px;
  }

  .publication-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .publication-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    padding: 22px 23px;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    background: #fff;
    transition: .2s ease;
  }

  .publication-card:hover {
    transform: translateY(-3px);
    border-color: #c7d2fe;
    box-shadow: 0 10px 25px #1725540d;
  }

  .publication-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 15px;
  }

  .publication-year {
    color: #4f46e5;
    font-size: 17px;
    font-weight: 800;
  }

  .doi-link {
    flex-shrink: 0;
    color: #4f46e5;
    font-size: 11px;
    font-weight: 800;
  }

  .publication-card h3 {
    margin: 0 0 12px;
    color: #172554;
    font-family: Manrope, sans-serif;
    font-size: 15px;
    line-height: 1.6;
  }

  .publisher-row {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 36px;
    margin-top: auto;
    margin-bottom: 14px;
  }

  .publisher-logo {
    display: block;
    width: 30px;
    height: 30px;
    flex-shrink: 0;
    object-fit: contain;
  }

  .publisher-name {
    color: #64748b;
    font-size: 11px;
    font-weight: 650;
  }

  .publisher-fallback {
    color: #475569;
    font-size: 12px;
    font-weight: 700;
  }

  .publication-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 7px;
    padding-top: 12px;
    border-top: 1px solid #f1f5f9;
  }

  .type-badge,
  .quartile-badge,
  .snip-badge {
    display: inline-flex;
    align-items: center;
    padding: 5px 9px;
    border-radius: 6px;
    font-size: 10px;
    font-weight: 800;
  }

  .type-badge {
    background: #f1f5f9;
    color: #475569;
  }

  .quartile-badge {
    background: #ecfdf5;
    color: #047857;
  }

  .snip-badge {
    background: #eef2ff;
    color: #4338ca;
  }

  @media (max-width: 700px) {
    .publication-list {
      grid-template-columns: 1fr;
    }

    .publication-heading {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
