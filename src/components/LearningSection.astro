---
const resources = [
  {
    number: '01',
    category: 'DEEP LEARNING',
    title: 'Understanding Grad-CAM',
    description: 'Visualizing CNN decisions using Gradient-weighted Class Activation Mapping.',
    tags: ['CNN', 'Explainable AI', 'Visualization'],
  },
  {
    number: '02',
    category: 'DIGITAL IMAGE PROCESSING',
    title: 'Image Segmentation Techniques',
    description: 'Explore thresholding, edge detection, region-based and morphological segmentation.',
    tags: ['Image Processing', 'Segmentation'],
  },
  {
    number: '03',
    category: 'DEEP LEARNING',
    title: 'Convolutional Neural Networks',
    description: 'Learn CNN architectures, convolution operations, pooling and feature extraction.',
    tags: ['CNN', 'Neural Networks'],
  },
  {
    number: '04',
    category: 'ACADEMIC COURSE',
    title: 'Digital Image Processing',
    description: 'Fundamental concepts, image transformations, enhancement and analysis.',
    tags: ['DIP', 'Teaching'],
  },
  {
    number: '05',
    category: 'ARTIFICIAL INTELLIGENCE',
    title: 'Deep Learning and Its Applications',
    description: 'Explore deep learning models and their applications in real-world problems.',
    tags: ['AI', 'Deep Learning'],
  },
];
---

<section class="section learning" id="learning">
  <div class="container">
    <div class="learning-heading">
      <div>
        <span class="section-label">TEACHING · LEARNING · KNOWLEDGE SHARING</span>
        <h2 class="section-title">Learning Resources</h2>
        <p class="section-description">
          Educational resources, technical tutorials and learning materials
          developed through teaching, research and academic engagement.
        </p>
      </div>
      <a href="/learning/" class="view-all">Explore Learning Hub ↗</a>
    </div>

    <div class="learning-grid">
      {resources.map((item) => (
        <article class="learning-card">
          <div class="learning-card-top">
            <span class="learning-number">{item.number}</span>
            <span class="learning-symbol">↗</span>
          </div>

          <span class="learning-category">{item.category}</span>
          <h3>{item.title}</h3>
          <p>{item.description}</p>

          <div class="learning-tags">
            {item.tags.map((tag) => <span>{tag}</span>)}
          </div>

          <a href="/learning/" class="learning-link">
            Explore Resource →
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .learning {
    background: #fff;
  }

  .learning-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
    margin-bottom: 36px;
  }

  .view-all {
    color: #4f46e5;
    font-size: 13px;
    font-weight: 700;
    white-space: nowrap;
  }

  .learning-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .learning-card {
    display: flex;
    flex-direction: column;
    min-height: 265px;
    padding: 24px;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    background: #fff;
    transition: .25s ease;
  }

  .learning-card:hover {
    transform: translateY(-5px);
    border-color: #c7d2fe;
    box-shadow: 0 14px 30px #1725540d;
  }

  .learning-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
  }

  .learning-number {
    color: #94a3b8;
    font-size: 12px;
    font-weight: 800;
  }

  .learning-symbol {
    display: grid;
    width: 34px;
    height: 34px;
    place-items: center;
    border-radius: 10px;
    background: #eef2ff;
    color: #4f46e5;
    font-size: 18px;
  }

  .learning-category {
    color: #4f46e5;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .8px;
  }

  .learning-card h3 {
    margin: 10px 0;
    color: #172554;
    font-family: Manrope, sans-serif;
    font-size: 18px;
    line-height: 1.45;
  }

  .learning-card p {
    margin: 0 0 18px;
    color: #64748b;
    font-size: 13px;
    line-height: 1.8;
  }

  .learning-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-bottom: 20px;
  }

  .learning-tags span {
    padding: 5px 8px;
    border-radius: 5px;
    background: #f1f5f9;
    color: #475569;
    font-size: 10px;
    font-weight: 600;
  }

  .learning-link {
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid #f1f5f9;
    color: #4f46e5;
    font-size: 12px;
    font-weight: 800;
  }

  @media(max-width: 850px) {
    .learning-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media(max-width: 560px) {
    .learning-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .learning-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
