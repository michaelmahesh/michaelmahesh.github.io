
---
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const products = [
  {
    name: 'CampusNanba',
    category: 'EDUCATION & STUDENT EXPERIENCE',
    tagline: 'Learning, skills and opportunities in one student-focused experience.',
    description: 'Helping students discover learning resources, practical projects, skill development and campus opportunities.',
    image: '/images/startups/campusnanba.png',
    status: 'Concept',
    href: '/startups/campusnanba/',
  },
  {
    name: 'DeptEase AI',
    category: 'ACADEMIC & INSTITUTIONAL SUPPORT',
    tagline: 'Simplifying routine academic department activities.',
    description: 'Exploring more organised ways for departments and faculty teams to coordinate academic and administrative work.',
    image: '/images/startups/deptease-ai.png',
    status: 'Concept',
    href: '/startups/deptease-ai/',
  },
  {
    name: 'AgentFlow AI',
    category: 'INTELLIGENT ASSISTANCE',
    tagline: 'Making repetitive digital tasks easier to manage.',
    description: 'Exploring practical AI assistance for everyday tasks, information handling and routine workflows.',
    image: '/images/startups/agentflow-ai.png',
    status: 'Concept',
    href: '/startups/agentflow-ai/',
  },
  {
    name: 'MetroLink AI',
    category: 'SMART MOBILITY',
    tagline: 'More convenient access to everyday travel information.',
    description: 'Exploring commuter-focused transport information and local mobility services.',
    image: '/images/startups/metrolink-ai.png',
    status: 'Concept',
    href: '/startups/metrolink-ai/',
  },
  {
    name: 'LifeLoop AI',
    category: 'EVERYDAY DIGITAL WELLBEING',
    tagline: 'Connecting useful everyday digital experiences.',
    description: 'Exploring simpler ways to organise selected lifestyle, wellbeing and productivity activities.',
    image: '/images/startups/lifeloop-ai.png',
    status: 'Concept',
    href: '/startups/lifeloop-ai/',
  },
  {
    name: 'Local Auto Stand Booking',
    category: 'LOCAL MOBILITY',
    tagline: 'Connecting passengers with nearby auto stands.',
    description: 'Helping passengers discover local auto services while improving visibility for drivers and auto stands.',
    image: '/images/startups/automate.png',
    status: 'Concept',
    href: '/startups/auto-stand-booking/',
  },
];

const innovationAreas = [
  {
    number: '01',
    title: 'Artificial Intelligence',
    description: 'Exploring AI, machine learning and intelligent automation for practical applications.',
  },
  {
    number: '02',
    title: 'Computer Vision',
    description: 'Research directions involving image analysis, visual recognition and intelligent monitoring.',
  },
  {
    number: '03',
    title: 'GPU-Accelerated Computing',
    description: 'Experimenting with computationally intensive AI models and high-performance processing.',
  },
  {
    number: '04',
    title: 'Applied Research',
    description: 'Translating research ideas into prototypes, experiments and potential real-world products.',
  },
];

const collaborationAreas = [
  {
    title: 'Students',
    description: 'Participate in product ideas, academic projects, research experiments and practical innovation.',
  },
  {
    title: 'Institutions',
    description: 'Explore academic collaborations, demonstrations, research activities and institutional pilots.',
  },
  {
    title: 'Industry',
    description: 'Share real-world challenges, evaluate product concepts and explore technology partnerships.',
  },
  {
    title: 'Customers',
    description: 'Discuss requirements, provide feedback and participate in suitable product validation activities.',
  },
];
---

<MainLayout
  title="Startup Lab | Dr. K. Michael Mahesh"
  description="A professor–student product innovation hub exploring practical digital products, AI research and real-world solutions."
>
  <Header />

  <main class="startup-hub">

    <!-- HERO -->
    <section class="hero">
      <div class="hero-content">
        <p class="eyebrow">STARTUP LAB · PROFESSOR–STUDENT INNOVATION</p>

        <h1>
          Ideas to products.
          <span>Innovation for everyone.</span>
        </h1>

        <p class="intro">
          We transform practical ideas into customer-focused digital products
          through collaborative innovation between professors and students.
          Our focus is simple: solve real problems, create useful experiences
          and make technology more accessible.
        </p>

        <div class="hero-actions">
          <a class="button primary" href="/startups/gateease/">
            Explore flagship product <span>↗</span>
          </a>
          <a class="button secondary" href="/work-with-us/">
            Work with us
          </a>
        </div>

        <div class="trust-points">
          <span>Practical solutions</span>
          <span>Cost-conscious approach</span>
          <span>Professor–student collaboration</span>
        </div>
      </div>

      <div class="hero-visual">
        <div class="visual-card">
          <div class="visual-top">
            <span class="visual-dot"></span>
            <span>STARTUP LAB</span>
            <span class="visual-line"></span>
          </div>

          <div class="visual-content">
            <span class="visual-kicker">IDEAS · RESEARCH · PRODUCTS</span>
            <h2>Building technology that solves real problems.</h2>
            <div class="visual-orbit">
              <div class="orbit-center">INNOVATION</div>
              <span class="orbit-node node-one">AI</span>
              <span class="orbit-node node-two">PRODUCTS</span>
              <span class="orbit-node node-three">RESEARCH</span>
              <span class="orbit-node node-four">PEOPLE</span>
            </div>
          </div>

          <div class="visual-footer">
            <span>Research-led thinking</span>
            <span>Real-world applications</span>
          </div>
        </div>
      </div>
    </section>

    <!-- FLAGSHIP PRODUCT -->
    <section class="flagship-section">
      <div class="flagship">
        <div class="flagship-image">
          <img
            src="/images/startups/gateease-hero.png"
            alt="GateEase gated community management product concept with Saveetha Engineering College banner"
            loading="lazy"
          />
          <span class="image-label">FLAGSHIP PRODUCT</span>
        </div>

        <div class="flagship-copy">
          <p class="eyebrow">FEATURED PRODUCT · FLAGSHIP INITIATIVE</p>

          <h2>Meet GateEase.</h2>

          <p class="flagline">
            One platform. Every community operation.
          </p>

          <p class="flag-description">
            GateEase is a community-management product initiative designed
            to help residential communities coordinate visitor entry,
            deliveries, residents and everyday gate activities more
            conveniently.
          </p>

          <ul class="feature-list">
            <li>Designed around Indian gated-community needs.</li>
            <li>Focused on residents, security teams and associations.</li>
            <li>Exploring future AI-assisted community operations.</li>
            <li>Developed with a practical and cost-conscious approach.</li>
          </ul>

          <div class="flagship-bottom">
            <span class="status development">In development</span>
            <a class="text-link" href="/startups/gateease/">
              Explore GateEase <span>→</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- PRODUCT PORTFOLIO -->
    <section class="portfolio">
      <div class="section-heading">
        <p class="eyebrow">OUR PRODUCT PORTFOLIO</p>
        <h2>Solutions for everyday challenges.</h2>
        <p>
          Explore our initiatives. Each product has its own intended users,
          customer benefits and development journey.
        </p>
      </div>

      <div class="product-grid">
        {products.map((product) => (
          <article class="product-card">
            <a class="image-link" href={product.href}>
              <img
                src={product.image}
                alt={`${product.name} concept illustration`}
                loading="lazy"
              />
            </a>

            <div class="card-content">
              <p class="category">{product.category}</p>

              <h3>{product.name}</h3>

              <p class="tagline">{product.tagline}</p>

              <p class="description">{product.description}</p>

              <div class="card-bottom">
                <span class="status">{product.status}</span>
                <a href={product.href}>Explore product ↗</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- ACADEMIC INNOVATION -->
    <section class="innovation-section">
      <div class="section-heading">
        <p class="eyebrow">ACADEMIC INNOVATION · RESEARCH ECOSYSTEM</p>
        <h2>Where academic research meets product innovation.</h2>
        <p>
          Combining academic expertise, student creativity and emerging
          technologies to explore solutions for practical challenges.
        </p>
      </div>

      <div class="institution-card">
        <div class="institution-mark">
          <span>AI</span>
        </div>

        <div class="institution-copy">
          <p class="institution-label">ACADEMIC RESEARCH ENVIRONMENT</p>
          <h3>Research, experimentation and innovation</h3>
          <p>
            The Startup Lab explores research-led product development
            through professor–student collaboration. Where appropriate,
            approved access to institutional high-performance computing
            and GPU facilities at Saveetha Engineering College can support
            computational experiments and AI research.
          </p>
        </div>

        <div class="institution-tags">
          <span>HPC</span>
          <span>GPU</span>
          <span>AI Research</span>
        </div>
      </div>

      <div class="innovation-grid">
        {innovationAreas.map((area) => (
          <article class="innovation-card">
            <span class="number">{area.number}</span>
            <h3>{area.title}</h3>
            <p>{area.description}</p>
          </article>
        ))}
      </div>

      <p class="institution-note">
        Institutional facilities are referenced as a potential research
        resource. Their use for any particular product or project is subject
        to applicable college approval, access arrangements and project
        requirements. Research directions do not imply that AI features
        are already commercially available.
      </p>
    </section>

    <!-- OUR APPROACH -->
    <section class="why-section">
      <div class="why-heading">
        <p class="eyebrow">WHY OUR APPROACH?</p>
        <h2>Useful products, without unnecessary complexity.</h2>
        <p>
          We focus on understanding users first and developing solutions
          around actual needs.
        </p>
      </div>

      <div class="why-grid">
        <article>
          <span class="why-icon">01</span>
          <h3>Built around real needs</h3>
          <p>
            We begin with everyday problems faced by people, institutions
            and local communities.
          </p>
        </article>

        <article>
          <span class="why-icon">02</span>
          <h3>Accessible by design</h3>
          <p>
            We aim for sensible, transparent pricing and avoid adding
            features customers do not need.
          </p>
        </article>

        <article>
          <span class="why-icon">03</span>
          <h3>Academic experience meets fresh ideas</h3>
          <p>
            Professor–student collaboration brings practical experience
            together with student creativity.
          </p>
        </article>

        <article>
          <span class="why-icon">04</span>
          <h3>Open to collaboration</h3>
          <p>
            We welcome customer feedback, institutional pilots,
            industry partnerships and funding discussions.
          </p>
        </article>
      </div>
    </section>

    <!-- COLLABORATION -->
    <section class="collaboration-section">
      <div class="section-heading">
        <p class="eyebrow">COLLABORATION OPPORTUNITIES</p>
        <h2>Let's build useful solutions together.</h2>
        <p>
          Innovation becomes more meaningful when researchers,
          students, customers and industry work together.
        </p>
      </div>

      <div class="collaboration-grid">
        {collaborationAreas.map((item, i) => (
          <article class="collaboration-card">
            <span class="number">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- PRICING -->
    <section class="pricing-note">
      <div class="pricing-symbol">₹</div>
      <div>
        <p class="eyebrow">OUR PRICING PHILOSOPHY</p>
        <h2>Practical value. Sensible pricing.</h2>
        <p>
          Our aim is to develop cost-conscious alternatives to expensive
          or unnecessarily complex market products. We do not publish
          unsupported claims that every product is cheaper than every
          competitor. Product scope, support and pricing will be discussed
          transparently according to customer requirements.
        </p>
      </div>
    </section>

    <!-- FINAL CTA -->
    <section class="cta">
      <p class="eyebrow">LET'S BUILD SOMETHING USEFUL</p>

      <h2>
        Are you looking for a product, a partner or an opportunity to invest?
      </h2>

      <p>
        Tell us about your requirement. We welcome demo requests,
        customer discussions, institutional adoption enquiries,
        industry collaborations and funding opportunities.
      </p>

      <div class="hero-actions">
        <a class="button light" href="/work-with-us/">
          Work with us ↗
        </a>
        <a
          class="button outline-light"
          href="mailto:michaelmaheshk@gmail.com?subject=Startup%20Product%20Enquiry"
        >
          Email us
        </a>
      </div>

      <p class="fine">
        Product status varies by initiative. A concept or development-stage
        listing does not imply that the product is generally available.
        Demonstrations, pilots, features and timelines are subject to
        confirmation.
      </p>
    </section>

  </main>

  <Footer />
</MainLayout>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  .startup-hub {
    max-width: 1220px;
    margin: auto;
    padding: 30px 30px 85px;
    color: #17233f;
  }

  .eyebrow {
    font-size: .72rem;
    letter-spacing: .14em;
    font-weight: 850;
    color: #6657c8;
    margin: 0 0 15px;
  }

  h1 {
    font-size: clamp(3.2rem, 6.8vw, 5.8rem);
    line-height: 1.02;
    letter-spacing: -.065em;
    margin: 0 0 25px;
  }

  h1 span {
    display: block;
    color: #6859c8;
  }

  h2 {
    font-size: clamp(1.85rem, 3.5vw, 2.75rem);
    line-height: 1.15;
    letter-spacing: -.045em;
    margin: 0 0 15px;
  }

  /* HERO */

  .hero {
    display: grid;
    grid-template-columns: 1.05fr .95fr;
    gap: 55px;
    align-items: center;
    padding: 62px 0 76px;
  }

  .hero-content {
    max-width: 730px;
  }

  .intro {
    font-size: 1.08rem;
    line-height: 1.85;
    color: #64708a;
    max-width: 710px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 25px;
  }

  .button {
    display: inline-flex;
    padding: 14px 20px;
    border-radius: 11px;
    text-decoration: none;
    font-weight: 750;
    align-items: center;
    justify-content: center;
    gap: 10px;
    transition: transform .2s ease, background .2s ease;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .primary {
    background: #6555c8;
    color: white;
  }

  .primary:hover {
    background: #5142aa;
  }

  .secondary {
    border: 1px solid #dce1ec;
    color: #293653;
    background: white;
  }

  .trust-points {
    display: flex;
    gap: 10px 22px;
    flex-wrap: wrap;
    margin-top: 27px;
    color: #68748a;
    font-size: .83rem;
  }

  .trust-points span::before {
    content: "✓";
    color: #6555c8;
    font-weight: 900;
    margin-right: 8px;
  }

  /* HERO VISUAL */

  .hero-visual {
    padding: 16px;
    border: 1px solid #e8e9f4;
    border-radius: 24px;
    background: linear-gradient(145deg, #f4f3ff, #fff);
  }

  .visual-card {
    background: #fff;
    border: 1px solid #e9eaf2;
    border-radius: 17px;
    overflow: hidden;
    box-shadow: 0 15px 40px rgba(25, 35, 75, .06);
  }

  .visual-top,
  .visual-footer {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 14px 18px;
    color: #7c8497;
    font-size: .67rem;
    font-weight: 850;
    letter-spacing: .1em;
  }

  .visual-top {
    border-bottom: 1px solid #eef0f5;
  }

  .visual-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #6859c8;
  }

  .visual-line {
    flex: 1;
    height: 1px;
    background: #edf0f5;
  }

  .visual-content {
    padding: 28px 25px 23px;
    text-align: center;
  }

  .visual-kicker {
    font-size: .65rem;
    letter-spacing: .15em;
    font-weight: 850;
    color: #7568c6;
  }

  .visual-content h2 {
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    margin: 12px auto 20px;
    max-width: 330px;
  }

  .visual-orbit {
    width: 220px;
    height: 180px;
    position: relative;
    margin: auto;
    display: grid;
    place-items: center;
    border: 1px dashed #d6d2f2;
    border-radius: 50%;
  }

  .orbit-center {
    width: 95px;
    height: 95px;
    display: grid;
    place-items: center;
    text-align: center;
    border-radius: 50%;
    background: #5148a8;
    color: #fff;
    font-size: .65rem;
    font-weight: 850;
    letter-spacing: .08em;
    box-shadow: 0 8px 24px #5148a833;
  }

  .orbit-node {
    position: absolute;
    padding: 7px 10px;
    border-radius: 8px;
    background: #f1f0ff;
    color: #5148a8;
    font-size: .62rem;
    font-weight: 850;
  }

  .node-one { top: 0; left: 85px; }
  .node-two { right: -25px; top: 72px; }
  .node-three { bottom: 0; left: 67px; }
  .node-four { left: -25px; top: 72px; }

  .visual-footer {
    justify-content: space-between;
    border-top: 1px solid #eef0f5;
    font-size: .62rem;
    letter-spacing: .02em;
  }

  /* FLAGSHIP */

  .flagship-section {
    padding: 5px 0 35px;
  }

  .flagship {
    display: grid;
    grid-template-columns: 1.05fr .95fr;
    gap: 38px;
    align-items: center;
    padding: 25px;
    border: 1px solid #e8eaf2;
    border-radius: 24px;
    background: #fbfbfe;
  }

  .flagship-image {
    position: relative;
    overflow: hidden;
    border-radius: 17px;
    background: #f0f2f8;
  }

  .flagship-image img {
    width: 100%;
    display: block;
    aspect-ratio: 16 / 9;
    object-fit: contain;
  }

  .image-label {
    position: absolute;
    left: 14px;
    bottom: 14px;
    background: #fff;
    color: #5148a8;
    border-radius: 7px;
    padding: 7px 10px;
    font-size: .65rem;
    letter-spacing: .08em;
    font-weight: 850;
  }

  .flagline {
    font-size: 1.2rem;
    font-weight: 750;
    color: #34415b;
  }

  .flag-description {
    color: #65718a;
    line-height: 1.8;
  }

  .feature-list {
    padding-left: 20px;
    color: #536079;
    line-height: 1.9;
    font-size: .91rem;
  }

  .flagship-bottom {
    display: flex;
    align-items: center;
    gap: 15px;
    flex-wrap: wrap;
    margin-top: 20px;
  }

  .status {
    display: inline-block;
    background: #f2f0ff;
    border: 1px solid #e2ddff;
    border-radius: 999px;
    padding: 7px 11px;
    color: #5d50b7;
    font-size: .76rem;
    font-weight: 750;
  }

  .development {
    background: #f1f5ff;
    color: #465d9e;
    border-color: #dce5fa;
  }

  .text-link {
    color: #6555c8;
    font-weight: 750;
    text-decoration: none;
  }

  /* PORTFOLIO */

  .portfolio {
    padding: 78px 0 75px;
  }

  .section-heading {
    max-width: 750px;
    margin-bottom: 30px;
  }

  .section-heading > p:last-child {
    color: #6a758b;
    line-height: 1.75;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .product-card {
    border: 1px solid #e8ebf2;
    border-radius: 18px;
    overflow: hidden;
    background: white;
    transition: transform .2s ease, box-shadow .2s ease;
  }

  .product-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 35px #18264a12;
  }

  .image-link {
    display: block;
    background: #f2f4f9;
    overflow: hidden;
  }

  .image-link img {
    width: 100%;
    display: block;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    transition: transform .3s ease;
  }

  .product-card:hover .image-link img {
    transform: scale(1.035);
  }

  .card-content {
    padding: 20px;
  }

  .category {
    font-size: .66rem;
    letter-spacing: .1em;
    color: #6a5bc6;
    font-weight: 850;
    margin: 0 0 9px;
  }

  .card-content h3 {
    font-size: 1.22rem;
    margin: 0 0 8px;
    color: #202d48;
  }

  .tagline {
    font-weight: 700;
    color: #34415b;
    line-height: 1.5;
    margin: 0 0 9px;
    font-size: .94rem;
  }

  .description {
    color: #6b768b;
    font-size: .88rem;
    line-height: 1.75;
    min-height: 76px;
  }

  .card-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    border-top: 1px solid #edf0f5;
    padding-top: 15px;
    margin-top: 16px;
  }

  .card-bottom a {
    color: #6555c8;
    font-weight: 750;
    font-size: .83rem;
    text-decoration: none;
  }

  /* ACADEMIC INNOVATION */

  .innovation-section {
    padding: 75px 28px;
    margin: 15px 0 55px;
    border-radius: 24px;
    background: #f7f7fd;
    border: 1px solid #e9e9f5;
  }

  .innovation-section .section-heading {
    max-width: 820px;
  }

  .institution-card {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 23px;
    align-items: center;
    background: #fff;
    border: 1px solid #e6e6f1;
    border-radius: 17px;
    padding: 25px;
    margin-bottom: 20px;
  }

  .institution-mark {
    width: 67px;
    height: 67px;
    border-radius: 17px;
    background: #eeedff;
    display: grid;
    place-items: center;
    color: #5148a8;
    font-size: 1.5rem;
    font-weight: 900;
  }

  .institution-label {
    color: #6657c8;
    font-size: .66rem;
    letter-spacing: .12em;
    font-weight: 850;
    margin: 0 0 7px;
  }

  .institution-copy h3 {
    margin: 0 0 8px;
    font-size: 1.2rem;
  }

  .institution-copy > p:last-child {
    color: #68758c;
    line-height: 1.75;
    font-size: .89rem;
    margin: 0;
  }

  .institution-tags {
    display: flex;
    gap: 7px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .institution-tags span {
    border-radius: 7px;
    background: #f1f0ff;
    color: #5148a8;
    padding: 7px 9px;
    font-size: .7rem;
    font-weight: 850;
  }

  .innovation-grid {
    display: grid;
