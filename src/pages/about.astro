---
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const favicon = (domain) => `https://www.google.com/s2/favicons?domain=${domain}&sz=64`;

const institutions = {
  saveetha: {
    name: 'Saveetha Engineering College, Chennai',
    logo: favicon('saveetha.ac.in'),
    url: 'https://saveetha.ac.in/',
  },
  srm: {
    name: 'SRM Institute of Science & Technology, Ramapuram',
    logo: favicon('srmist.edu.in'),
    url: 'https://www.srmist.edu.in/',
  },
  joseph: {
    name: 'St. Joseph College of Engineering',
    logo: 'https://www.stjoseph.ac.in/assets/images/Event%20/June%202025/webnewlogo1.png',
    url: 'https://www.stjoseph.ac.in/',
  },
  sairam: {
    name: 'Sri Sairam Engineering College, Chennai',
    logo: favicon('sairam.edu.in'),
    url: 'https://sairam.edu.in/',
  },
  xavier: {
    name: "St. Xavier's Catholic College of Engineering, Nagercoil",
    logo: favicon('sxcce.edu.in'),
    url: 'https://sxcce.edu.in/web2/',
  },
  anna: {
    name: 'Anna University, Chennai',
    logo: favicon('annauniv.edu'),
    url: 'https://www.annauniv.edu/',
  },
};

const education = [
  { year: '2021', degree: 'Ph.D.', field: 'Information & Communication Engineering', institution: institutions.anna },
  { year: '2011', degree: 'M.E.', field: 'Computer & Communication Engineering', institution: institutions.sairam },
  { year: '2008', degree: 'B.E.', field: 'Electronics & Communication Engineering', institution: institutions.xavier },
];

const career = [
  { period: 'Jun 2026 – Present', role: 'Professor · Department of ECE', institution: institutions.saveetha, current: true },
  { period: 'Dec 2023 – May 2026', role: 'Associate Professor · Department of ECE', institution: institutions.saveetha },
  { period: 'Jul 2023 – Nov 2023', role: 'Assistant Professor · ECE', institution: institutions.srm },
  { period: 'Apr 2023 – Jul 2023', role: 'Associate Professor · ECE', institution: institutions.joseph },
  { period: 'Jul 2011 – Apr 2023', role: 'Assistant Professor · ECE', institution: institutions.joseph },
];

const researchAreas = [
  'Artificial Intelligence & Deep Learning',
  'Machine Learning & Computer Vision',
  'Medical Image Processing & Healthcare AI',
  'Advanced Driver Assistance Systems (ADAS)',
  'Intelligent Transportation Systems',
  'Evolutionary & Metaheuristic Optimization',
  'Vision Transformers & Foundation Models',
  'Multimodal AI & Vision-Language Models',
  'Generative AI for Healthcare',
];

const patents = [
  { title: 'PPG Signal-Based Biometric Recognition for Smartwatch Locking System', number: 'IN 201941045486', status: 'Under examination', kind: 'pending' },
  { title: 'AI-Based Smart Healthcare Monitoring System', number: 'IN 202341000695', status: 'Under examination', kind: 'pending' },
  { title: 'IoT-Based Device to Measure Sugar Level in Diabetes Using Saliva', number: '463340-001', status: 'Granted · 24 June 2025', kind: 'granted' },
];

const providers = {
  Udemy: { logo: 'https://cdn.simpleicons.org/udemy/A435F0', url: 'https://www.udemy.com/' },
  NVIDIA: { logo: 'https://cdn.simpleicons.org/nvidia/76B900', url: 'https://www.nvidia.com/' },
  'OpenCV University': { logo: 'https://cdn.simpleicons.org/opencv/5C3EE8', url: 'https://opencv.org/' },
};

const certifications = [
  { year: '2026', month: 'Sep', title: 'Agentic AI for Beginner: Build AI Agents From Scratch', issuer: 'Udemy' },
  { year: '2026', month: 'Mar', title: 'Mastering Python OpenCV: With 34 Real-World Projects', issuer: 'Udemy' },
  { year: '2026', month: 'Feb', title: 'Complete Computer Vision Bootcamp With PyTorch & TensorFlow', issuer: 'Udemy' },
  { year: '2025', month: 'Dec', title: 'Computer Vision for Industrial Inspection', issuer: 'NVIDIA' },
  { year: '2025', month: 'May', title: 'Deep Learning with PyTorch 2.x', issuer: 'OpenCV University' },
  { year: '2024', month: 'Dec', title: 'Mastering OpenCV with Python', issuer: 'OpenCV University' },
  { year: '2024', month: 'Nov', title: 'AI Art Generation for Everyone', issuer: 'OpenCV University' },
];

const grants = [
  { title: 'Autonomous Mobile Robot Vehicle for Medical Delivery to Hospitalized Patients', agency: 'TNSCST', amount: '₹10,000', status: 'Applied' },
  { title: 'Intelligent Covid-19 Pandemic Bus Service with Safety Measure', agency: 'TNSCST', amount: '₹7,500', status: 'Sanctioned' },
  { title: 'Teaching STEMM to Rural School Students and Teachers', agency: 'DST', amount: '₹3,50,000', status: 'Applied' },
];

const memberships = [
  { name: 'Institution of Engineers (India)', grade: 'MIE', logo: favicon('ieindia.org'), url: 'https://www.ieindia.org/' },
  { name: 'IEEE', grade: 'Professional member', logo: 'https://cdn.simpleicons.org/ieee/00629B', url: 'https://www.ieee.org/' },
  { name: 'IET, United Kingdom', grade: 'Professional member', logo: favicon('theiet.org'), url: 'https://www.theiet.org/' },
];

const leadership = [
  {
    title: 'Academic quality & accreditation',
    items: [
      'NAAC Criteria 2 Coordinator',
      'ISO College-Level Coordinator & Internal Auditor (2017–2023)',
      'Anna University Internal Academic Auditor (2022–2023)',
      'NBA Accreditation – ECE Department Coordinator',
      'AICTE & Anna University Accreditation Coordinator',
    ],
  },
  {
    title: 'Student development & department roles',
    items: [
      'Placement Officer (2020–2022)',
      'Subject Allocation & Department Timetable In-Charge',
      'Second-Year Class Coordinator',
      'Industrial Visit and Symposium Coordinator',
      'Department Laboratory Coordinator',
      'Discipline Committee Member',
    ],
  },
  {
    title: 'Professional and academic activities',
    items: [
      'Faculty Adviser – IEI, IET & IEEE',
      'IET UK Young Professional Section Executive Committee Member',
      'ICIECS 2018 & 2019 Organizing Committee',
      'Faculty Development Programme Coordinator',
    ],
  },
];

const subjects = [
  'Digital Image Processing',
  'Deep Learning',
  'Artificial Intelligence',
  'Digital Electronics',
  'Microprocessors & Microcontrollers',
  'Communication Systems',
  'Electronic Devices',
  'Circuit Analysis',
];

const sectionTitles = [
  { id: 'education', number: '01', label: 'ACADEMIC BACKGROUND', title: 'Education' },
  { id: 'experience', number: '02', label: 'CAREER', title: 'Academic experience' },
  { id: 'research', number: '03', label: 'RESEARCH PROFILE', title: 'Research interests' },
  { id: 'impact', number: '04', label: 'RESEARCH & INNOVATION', title: 'Research contributions' },
  { id: 'development', number: '05', label: 'LIFELONG LEARNING', title: 'Professional certifications' },
  { id: 'recognition', number: '06', label: 'RECOGNITION', title: 'Awards & professional memberships' },
  { id: 'leadership', number: '07', label: 'ACADEMIC SERVICE', title: 'Academic leadership & service' },
  { id: 'teaching', number: '08', label: 'TEACHING PROFILE', title: 'Courses taught' },
];
---

<MainLayout
  title="About | Dr. K. Michael Mahesh"
  description="Academic profile of Dr. K. Michael Mahesh, Professor of ECE at Saveetha Engineering College, Chennai. Explore education, experience, research, patents, supervision and academic leadership."
>
  <Header />

  <main class="about-page">
    <!-- INTRODUCTION -->
    <section class="profile-hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <span class="eyebrow">ACADEMIC PROFILE</span>
          <h1>Dr. K. Michael Mahesh</h1>
          <p class="hero-role">Professor, Department of Electronics and Communication Engineering</p>
          <a class="institution-link" href={institutions.saveetha.url} target="_blank" rel="noreferrer">
            <img src={institutions.saveetha.logo} alt="" />
            Saveetha Engineering College, Chennai <span aria-hidden="true">↗</span>
          </a>
          <p class="bio">
            I am an academician and researcher with more than 15 years of teaching experience. My work and research interests span Artificial Intelligence, Deep Learning, Computer Vision and healthcare technologies. I am interested in developing practical, intelligent solutions through interdisciplinary research, student mentoring and innovation.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="/publications/">View publications <span aria-hidden="true">↗</span></a>
            <a class="button button-secondary" href="mailto:michaelmaheshk@gmail.com">Get in touch</a>
          </div>
        </div>

        <aside class="profile-aside" aria-label="Professional highlights">
          <div class="aside-top">
            <span class="aside-kicker">PROFILE AT A GLANCE</span>
            <span class="aside-mark">MK</span>
          </div>
          <div class="fact-row">
            <strong>15+</strong>
            <span>Years of teaching experience</span>
          </div>
          <div class="fact-row">
            <strong>06</strong>
            <span>Ph.D. scholars currently guided</span>
          </div>
          <div class="fact-row">
            <strong>03</strong>
            <span>Patent records · 1 granted</span>
          </div>
          <div class="fact-row">
            <strong>2021</strong>
            <span>Ph.D. · Anna University</span>
          </div>
          <div class="supervisor-note">
            <span class="note-dot"></span>
            Recognized Research Supervisor, Anna University
          </div>
        </aside>
      </div>
    </section>

    <!-- EDUCATION -->
    <section class="section" id="education">
      <div class="container">
        <div class="section-heading">
          <span class="section-label section-label-icon"><svg class="section-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 10 12 5 2 10l10 5 10-5Z"/><path d="M6 12v5c3.5 2.5 8.5 2.5 12 0v-5M22 10v6"/></svg><span>01 / ACADEMIC BACKGROUND</span></span>
          <h2>Education</h2>
          <p>My academic qualifications and the institutions where I studied.</p>
        </div>
        <div class="timeline">
          {education.map((item) => (
            <article class="timeline-row">
              <span class="timeline-year">{item.year}</span>
              <a class="institution-logo" href={item.institution.url} target="_blank" rel="noreferrer" aria-label={item.institution.name}>
                <img src={item.institution.logo} alt="" loading="lazy" />
              </a>
              <div class="timeline-main">
                <h3>{item.degree} <span>·</span> {item.field}</h3>
                <a href={item.institution.url} target="_blank" rel="noreferrer">{item.institution.name} <span aria-hidden="true">↗</span></a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- PROFESSIONAL EXPERIENCE -->
    <section class="section section-tint" id="experience">
      <div class="container">
        <div class="section-heading">
          <span class="section-label section-label-icon"><svg class="section-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="7" width="18" height="14" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 12h18M10 12v2h4v-2"/></svg><span>02 / CAREER</span></span>
          <h2>Academic experience</h2>
          <p>My academic appointments and professional progression.</p>
        </div>
        <div class="timeline career-timeline">
          {career.map((item) => (
            <article class="timeline-row">
              <span class="timeline-year period">{item.period}</span>
              <a class="institution-logo" href={item.institution.url} target="_blank" rel="noreferrer" aria-label={item.institution.name}>
                <img src={item.institution.logo} alt="" loading="lazy" />
              </a>
              <div class="timeline-main">
                <h3>{item.role}</h3>
                <a href={item.institution.url} target="_blank" rel="noreferrer">{item.institution.name} <span aria-hidden="true">↗</span></a>
              </div>
              {item.current && <span class="current-label">Current</span>}
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- RESEARCH -->
    <section class="section" id="research">
      <div class="container">
        <div class="section-heading">
          <span class="section-label section-label-icon"><svg class="section-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 3 6 6M7 5l4-4M5 7l4-4M14 10l7 7-4 4-7-7M3 21l6-6"/></svg><span>03 / RESEARCH PROFILE</span></span>
          <h2>Research interests</h2>
          <p>My research focuses on intelligent systems, computer vision and AI-driven healthcare applications.</p>
        </div>
        <ul class="research-list">
          {researchAreas.map((area) => <li>{area}</li>)}
        </ul>
        <a class="text-link publication-link" href="/publications/">
          Explore my publications <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>

    <!-- RESEARCH IMPACT -->
    <section class="section section-tint" id="impact">
      <div class="container">
        <div class="section-heading">
          <span class="section-label section-label-icon"><svg class="section-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18h6M10 22h4M8 14a7 7 0 1 1 8 0c-.8.6-1 1.2-1 2H9c0-.8-.2-1.4-1-2Z"/></svg><span>04 / RESEARCH & INNOVATION</span></span>
          <h2>Research contributions</h2>
          <p>An overview of my patent contributions, doctoral supervision and research funding activities.</p>
        </div>

        <div class="impact-grid">
          <article class="impact-block">
            <div class="block-heading">
              <span class="block-index">A</span>
              <h3>Patents</h3>
            </div>
            <ul class="record-list">
              {patents.map((patent) => (
                <li>
                  <div class="record-copy">
                    <strong>{patent.title}</strong>
                    <small>{patent.number}</small>
                  </div>
                  <span class:list={['status', patent.kind]}>{patent.status}</span>
                </li>
              ))}
            </ul>
          </article>

          <article class="impact-block supervision-block">
            <div class="block-heading">
              <span class="block-index">B</span>
              <h3>Ph.D. supervision</h3>
            </div>
            <p class="supervisor-reference">Recognized Research Supervisor, Anna University · Ref. No. 4040049 · ECE</p>
            <div class="scholar-numbers">
              <div><strong>06</strong><span>Scholars under guidance</span></div>
              <div><strong>02</strong><span>Confirmation completed</span></div>
              <div><strong>04</strong><span>Coursework</span></div>
            </div>
          </article>
        </div>

        <article class="grants-block">
          <div class="block-heading">
            <span class="block-index">C</span>
            <h3>Research grants</h3>
          </div>
          <ul class="grant-list">
            {grants.map((grant) => (
              <li>
                <div>
                  <strong>{grant.title}</strong>
                  <small>{grant.agency} · {grant.amount}</small>
                </div>
                <span class="grant-status">{grant.status}</span>
              </li>
            ))}
          </ul>
        </article>
      </div>
    </section>

    <!-- CERTIFICATIONS -->
    <section class="section" id="development">
      <div class="container">
        <div class="section-heading">
          <span class="section-label section-label-icon"><svg class="section-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="6"/><path d="m8.2 13-1 8 4.8-2.5 4.8 2.5-1-8"/></svg><span>05 / LIFELONG LEARNING</span></span>
          <h2>Professional certifications</h2>
          <p>Selected courses and technical training undertaken to strengthen my expertise.</p>
        </div>
        {['2026', '2025', '2024'].map((year) => (
          <div class="cert-year">
            <h3>{year}</h3>
            <ul>
              {certifications.filter((item) => item.year === year).map((item) => (
                <li>
                  <a class="provider-logo" href={providers[item.issuer].url} target="_blank" rel="noreferrer" aria-label={item.issuer}>
                    <img src={providers[item.issuer].logo} alt="" loading="lazy" />
                  </a>
                  <div class="cert-copy">
                    <strong>{item.title}</strong>
                    <a href={providers[item.issuer].url} target="_blank" rel="noreferrer">{item.issuer} <span aria-hidden="true">↗</span></a>
                  </div>
                  <span class="cert-month">{item.month}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- AWARDS AND MEMBERSHIPS -->
    <section class="section section-tint" id="recognition">
      <div class="container">
        <div class="section-heading">
          <span class="section-label section-label-icon"><svg class="section-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0V4ZM7 6H4v2a4 4 0 0 0 4 4M17 6h3v2a4 4 0 0 1-4 4"/></svg><span>06 / RECOGNITION</span></span>
          <h2>Awards & professional memberships</h2>
        </div>
        <div class="award-line">
          <span class="award-year">2012</span>
          <div>
            <strong>Dr. C. V. Raman Achievement Award</strong>
            <p>IET UK Young Professional Section</p>
          </div>
        </div>
        <h3 class="subheading">Professional members</h3>
        <div class="membership-grid">
          {memberships.map((member) => (
            <a class="membership-item" href={member.url} target="_blank" rel="noreferrer">
              <img src={member.logo} alt="" loading="lazy" />
              <span>{member.name}</span>
              <small>{member.grade}</small>
              <span class="membership-arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- LEADERSHIP -->
    <section class="section" id="leadership">
      <div class="container">
        <div class="section-heading">
          <span class="section-label section-label-icon"><svg class="section-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6M9 9h.01M15 9h.01"/></svg><span>07 / ACADEMIC SERVICE</span></span>
          <h2>Academic leadership & service</h2>
          <p>Academic and administrative responsibilities undertaken at St. Joseph College of Engineering from 2011 to 2023.</p>
        </div>
        <div class="leadership-grid">
          {leadership.map((group) => (
            <article class="leadership-group">
              <h3>{group.title}</h3>
              <ul>
                {group.items.map((item) => <li>{item}</li>)}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- TEACHING -->
    <section class="section section-tint" id="teaching">
      <div class="container">
        <div class="section-heading">
          <span class="section-label section-label-icon"><svg class="section-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8M12 17v4M7 9h10M7 12h6"/></svg><span>08 / TEACHING PROFILE</span></span>
          <h2>Courses taught</h2>
        </div>
        <ul class="subject-list">
          {subjects.map((subject) => <li>{subject}</li>)}
        </ul>
      </div>
    </section>

    <!-- CONTACT -->
    <section class="section contact-section" id="contact">
      <div class="container">
        <div class="contact-panel">
          <div>
            <span class="eyebrow">LET'S CONNECT</span>
            <h2>Research · Teaching · Innovation</h2>
            <p>I welcome opportunities for academic collaboration, research partnerships and technology-driven initiatives.</p>
          </div>
          <div class="contact-actions">
            <a class="button button-primary" href="mailto:michaelmaheshk@gmail.com">Send an email <span aria-hidden="true">↗</span></a>
            <a class="social-link" href="https://www.linkedin.com/in/michaelmahesh/" target="_blank" rel="noreferrer">LinkedIn ↗</a>
            <a class="social-link" href="https://github.com/michaelmahesh" target="_blank" rel="noreferrer">GitHub ↗</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</MainLayout>

<style>
  .about-page {
    --about-primary: #4f46e5;
    --about-primary-dark: #3730a3;
    --about-navy: #172554;
    --about-text: #334155;
    --about-muted: #64748b;
    --about-border: #e2e8f0;
    --about-tint: #f8fafc;
    color: var(--about-text);
    font-family: 'DM Sans', sans-serif;
  }

  .about-page * { box-sizing: border-box; }
  .about-page a { text-decoration: none; }
  .about-page .container { width: min(1060px, calc(100% - 48px)); margin: 0 auto; }
  .section { padding: 76px 0; }
  .section-tint { background: var(--about-tint); }
  .eyebrow, .section-label {
    color: var(--about-primary);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.8px;
    text-transform: uppercase;
  }

  /* Hero */
  .profile-hero {
    padding: 76px 0 70px;
    background:
      radial-gradient(circle at 88% 12%, rgba(99, 102, 241, .09), transparent 27%),
      linear-gradient(135deg, #fbfcff 0%, #f7f9ff 100%);
    border-bottom: 1px solid var(--about-border);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(250px, .75fr);
    gap: 64px;
    align-items: center;
  }
  .hero-copy h1 {
    margin: 13px 0 10px;
    color: var(--about-navy);
    font-family: 'Manrope', sans-serif;
    font-size: clamp(36px, 5vw, 54px);
    line-height: 1.12;
    letter-spacing: -2px;
    font-weight: 800;
  }
  .hero-role { margin: 0; color: #334155; font-size: 15px; line-height: 1.7; font-weight: 650; }
  .institution-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 12px;
    color: var(--about-muted);
    font-size: 13px;
  }
  .institution-link img { width: 19px; height: 19px; object-fit: contain; }
  .institution-link span { color: var(--about-primary); }
  .bio {
    max-width: 680px;
    margin: 24px 0 22px;
    color: var(--about-muted);
    font-size: 14px;
    line-height: 1.9;
  }
  .hero-actions, .contact-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; }
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    min-height: 42px;
    padding: 0 17px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 700;
    transition: transform .2s ease, background .2s ease;
  }
  .button:hover { transform: translateY(-2px); }
  .button-primary { background: var(--about-primary); color: #fff; }
  .button-primary:hover { background: var(--about-primary-dark); }
  .button-secondary { border: 1px solid #cbd5e1; background: #fff; color: var(--about-navy); }
  .profile-aside {
    padding: 22px 23px 18px;
    border: 1px solid #e0e7ff;
    border-radius: 15px;
    background: rgba(255,255,255,.88);
    box-shadow: 0 14px 40px rgba(30, 41, 59, .045);
  }
  .aside-top { display: flex; align-items: center; justify-content: space-between; padding-bottom: 13px; border-bottom: 1px solid var(--about-border); }
  .aside-kicker { color: var(--about-muted); font-size: 9px; font-weight: 800; letter-spacing: 1.5px; }
  .aside-mark {
    display: grid; place-items: center; width: 29px; height: 29px;
    border-radius: 9px; background: #eef2ff; color: var(--about-primary);
    font-family: 'Manrope', sans-serif; font-size: 10px; font-weight: 800;
  }
  .fact-row { display: flex; align-items: center; gap: 14px; padding: 14px 0; border-bottom: 1px solid #edf0f5; }
  .fact-row strong {
    min-width: 62px; color: var(--about-navy); font-family: 'Manrope', sans-serif;
    font-size: 25px; line-height: 1; letter-spacing: -.8px;
  }
