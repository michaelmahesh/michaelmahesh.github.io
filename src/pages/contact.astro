
---
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const contactOptions = [
  {
    title: 'Academic Collaboration',
    description: 'Research collaboration, Ph.D. supervision enquiries, academic partnerships and institutional activities.',
    emailSubject: 'Academic Collaboration',
  },
  {
    title: 'Research & Publications',
    description: 'Research discussions, publications, technical exchange and interdisciplinary opportunities.',
    emailSubject: 'Research Enquiry',
  },
  {
    title: 'Startup & Product Innovation',
    description: 'Product demonstrations, customer requirements, industry partnerships and innovation opportunities.',
    emailSubject: 'Startup and Product Enquiry',
  },
  {
    title: 'Student Mentoring',
    description: 'Student projects, technical mentoring, internships and career-oriented learning discussions.',
    emailSubject: 'Student Mentoring Enquiry',
  },
];
---

<MainLayout
  title="Contact | Dr. K. Michael Mahesh"
  description="Contact Dr. K. Michael Mahesh for academic collaboration, research, mentoring and product innovation."
>
  <Header />

  <main class="contact-page">
    <section class="hero">
      <p class="eyebrow">CONTACT · CONNECT · COLLABORATE</p>
      <h1>Let's start a <span>conversation.</span></h1>
      <p class="intro">
        I welcome meaningful conversations around research, academic
        collaboration, technology, student mentoring and product innovation.
        Feel free to get in touch.
      </p>
    </section>

    <section class="contact-grid">
      <div class="contact-main">
        <p class="eyebrow">GET IN TOUCH</p>
        <h2>I'd be glad to hear from you.</h2>
        <p class="description">
          Whether you are a researcher, student, academic institution,
          industry professional or potential product collaborator,
          please share your enquiry.
        </p>

        <div class="email-card">
          <span class="icon">✉</span>
          <div>
            <span class="small-label">EMAIL</span>
            <a href="mailto:michaelmaheshk@gmail.com">
              michaelmaheshk@gmail.com
            </a>
          </div>
        </div>

        <div class="email-card">
          <span class="icon">⌖</span>
          <div>
            <span class="small-label">ACADEMIC AFFILIATION</span>
            <strong>Professor – Department of ECE</strong>
            <p>Saveetha Engineering College, Chennai, India</p>
          </div>
        </div>

        <a
          class="primary-button"
          href="mailto:michaelmaheshk@gmail.com?subject=Website%20Enquiry"
        >
          Send an Email <span>↗</span>
        </a>
      </div>

      <aside class="contact-aside">
        <p class="eyebrow">CONNECT WITH PURPOSE</p>
        <h2>What would you like to discuss?</h2>

        {contactOptions.map((option) => (
          <a
            class="contact-option"
            href={`mailto:michaelmaheshk@gmail.com?subject=${encodeURIComponent(option.emailSubject)}`}
          >
            <div>
              <h3>{option.title}</h3>
              <p>{option.description}</p>
            </div>
            <span>↗</span>
          </a>
        ))}
      </aside>
    </section>

    <section class="closing">
      <p class="eyebrow">LET'S CREATE SOMETHING MEANINGFUL</p>
      <h2>Ideas grow through conversations and collaboration.</h2>
      <a href="/work-with-us/">Explore collaboration opportunities →</a>
    </section>
  </main>

  <Footer />
</MainLayout>

<style>
  .contact-page {
    max-width: 1120px;
    margin: auto;
    padding: 75px 28px 90px;
    color: #17233f;
  }

  .eyebrow {
    color: #6555c8;
    font-size: .72rem;
    font-weight: 850;
    letter-spacing: .13em;
    margin: 0 0 15px;
  }

  .hero {
    max-width: 780px;
    margin-bottom: 65px;
  }

  h1 {
    font-size: clamp(3rem, 6vw, 5rem);
    letter-spacing: -.06em;
    line-height: 1.06;
    margin: 0 0 22px;
  }

  h1 span {
    color: #6555c8;
  }

  .intro {
    color: #68748b;
    font-size: 1.08rem;
    line-height: 1.85;
    max-width: 720px;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 55px;
    align-items: start;
  }

  .contact-main h2,
  .contact-aside h2 {
    font-size: 1.9rem;
    letter-spacing: -.04em;
    margin: 0 0 15px;
  }

  .description {
    color: #68748b;
    line-height: 1.8;
    margin-bottom: 28px;
  }

  .email-card {
    display: flex;
    gap: 16px;
    align-items: center;
    padding: 20px;
    margin-bottom: 13px;
    border: 1px solid #e8eaf2;
    border-radius: 14px;
    background: #fff;
  }

  .icon {
    width: 43px;
    height: 43px;
    flex: 0 0 43px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: #f0efff;
    color: #6555c8;
    font-size: 1.3rem;
  }

  .small-label {
    display: block;
    color: #858da0;
    font-size: .65rem;
    font-weight: 850;
    letter-spacing: .1em;
    margin-bottom: 5px;
  }

  .email-card a,
  .email-card strong {
    color: #263552;
    font-weight: 750;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .email-card p {
    color: #68748b;
    font-size: .85rem;
    margin: 5px 0 0;
  }

  .primary-button {
    display: inline-flex;
    margin-top: 15px;
    padding: 15px 21px;
    gap: 12px;
    border-radius: 10px;
    background: #6555c8;
    color: white;
    font-weight: 750;
    text-decoration: none;
  }

  .contact-aside {
    padding: 28px;
    border: 1px solid #e8eaf2;
    border-radius: 19px;
    background: #fafaff;
  }

  .contact-option {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    padding: 17px 0;
    border-bottom: 1px solid #e9eaf2;
    color: inherit;
    text-decoration: none;
  }

  .contact-option:last-child {
    border-bottom: 0;
  }

  .contact-option h3 {
    margin: 0 0 6px;
    font-size: 1rem;
  }

  .contact-option p {
    color: #68748b;
    font-size: .84rem;
    line-height: 1.65;
    margin: 0;
  }

  .contact-option > span {
    color: #6555c8;
    font-weight: 850;
  }

  .closing {
    margin-top: 75px;
    padding: 48px 25px;
    border-radius: 20px;
    background: #18264a;
    color: white;
    text-align: center;
  }

  .closing .eyebrow {
    color: #c5beff;
  }

  .closing h2 {
    max-width: 700px;
    margin: 0 auto 20px;
    font-size: clamp(1.7rem, 3vw, 2.5rem);
  }

  .closing a {
    color: #d5d0ff;
    font-weight: 750;
    text-decoration: none;
  }

  @media (max-width: 760px) {
    .contact-page {
      padding: 45px 18px 65px;
    }

    .hero {
      margin-bottom: 42px;
    }

    .contact-grid {
      grid-template-columns: 1fr;
      gap: 35px;
    }

    .contact-aside {
      padding: 22px;
    }
  }
</style>
