---
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const projects = [
  {
    number: "01",
    title: "GeoSentinel",
    category: "Environmental AI · Research",
    description: "An explainable foundation-model direction for multi-temporal environmental change detection using satellite imagery.",
    tags: ["AI", "Foundation Models", "Remote Sensing"],
    repo: "https://github.com/michaelmahesh/GeoSentinel",
    detail: "/projects/geosentinel/",
    visual: "geo",
    status: "Research project"
  },
  {
    number: "02",
    title: "TAQB-V4",
    category: "Medical AI · Research",
    description: "A hybrid quantum-classical residual-fusion framework for multi-class blood-cell classification using microscopic images.",
    tags: ["Computer Vision", "Medical AI", "Quantum ML"],
    repo: "https://github.com/michaelmahesh/TAQB-V4",
    detail: "/projects/taqb-v4/",
    visual: "medical",
    status: "Research project"
  },
  {
    number: "03",
    title: "YOLOv8 Camera Detection",
    category: "Computer Vision",
    description: "Real-time object detection using YOLOv8 and laptop-camera input for practical computer-vision experimentation.",
    tags: ["YOLOv8", "OpenCV", "Python"],
    repo: "https://github.com/michaelmahesh/YOLOv8-Laptop-Camera-Object-Detection",
    detail: "/projects/yolov8-camera-detection/",
    visual: "camera",
    status: "Implementation"
  },
  {
    number: "04",
    title: "FaceMorph-OpenCV",
    category: "Computer Vision · Demonstration",
    description: "Facial landmark detection and face morphing using MediaPipe and OpenCV, with Delaunay triangulation and triangle-wise affine warping.",
    tags: ["OpenCV", "MediaPipe", "Python", "NumPy"],
    repo: "https://github.com/michaelmahesh/FaceMorph-OpenCV",
    detail: "/projects/face-morph/",
    visual: "face",
    status: "Technical walkthrough"
  }
];
---
<MainLayout title="Projects | Dr. K. Michael Mahesh" description="Selected research and software projects in computer vision, medical AI, environmental AI and intelligent systems.">
  <Header />
  <main class="projects-page">
    <section class="projects-hero">
      <div class="eyebrow"><span></span> PROJECT LAB</div>
      <h1>Research ideas.<br /><em>Working implementations.</em></h1>
      <p class="hero-copy">A selected collection of research-driven and practical projects exploring artificial intelligence, computer vision and intelligent systems.</p>
      <div class="hero-actions">
        <a class="primary-link" href="https://github.com/michaelmahesh" target="_blank" rel="noopener noreferrer">Explore GitHub <span>↗</span></a>
        <a class="text-link" href="#selected-projects">Browse selected projects <span>↓</span></a>
      </div>
      <div class="hero-note"><span class="note-dot"></span> Selected work · Project descriptions reflect the documented scope of each repository</div>
    </section>

    <section class="project-section" id="selected-projects">
      <div class="section-top">
        <div>
          <div class="section-kicker">SELECTED WORK</div>
          <h2>Projects and explorations</h2>
          <p>Explore the project overview, technical focus and source repository.</p>
        </div>
        <div class="count"><strong>04</strong><span>SELECTED PROJECTS</span></div>
      </div>

      <div class="project-grid">
        {projects.map((project) => (
          <article class={`project-card ${project.visual}`}>
            <a class="visual-link" href={project.detail} aria-label={`View ${project.title} details`}>
              <div class="project-visual">
                {project.visual === "face" ? (
                  <div class="face-visual">
                    <img src="/images/projects/face-morph/face1.jpg" alt="First input face used in the FaceMorph demonstration" loading="lazy" />
                    <span class="visual-arrow">→</span>
                    <img src="/images/projects/face-morph/face2.jpg" alt="Second input face used in the FaceMorph demonstration" loading="lazy" />
                    <span class="visual-caption">LANDMARKS · ALIGNMENT · MORPHING</span>
                  </div>
                ) : project.visual === "geo" ? (
                  <div class="abstract-visual geo-visual"><span class="orbit orbit-one"></span><span class="orbit orbit-two"></span><span class="geo-core">G</span><span class="visual-caption">MULTI-TEMPORAL · EARTH OBSERVATION</span></div>
                ) : project.visual === "medical" ? (
                  <div class="abstract-visual medical-visual"><span class="cell cell-one"></span><span class="cell cell-two"></span><span class="cell cell-three"></span><span class="visual-caption">MICROSCOPY · MEDICAL AI</span></div>
                ) : (
                  <div class="abstract-visual camera-visual"><span class="camera-frame"><span></span></span><span class="visual-caption">REAL-TIME · OBJECT DETECTION</span></div>
                )}
              </div>
            </a>
            <div class="card-body">
              <div class="card-meta"><span>{project.category}</span><span>{project.number}</span></div>
              <h3>{project.title}</h3>
              <p>{project.description}</p>
              <div class="tag-list">{project.tags.map(tag => <span>{tag}</span>)}</div>
              <div class="card-actions">
                <a class="detail-link" href={project.detail}>Project details <span>↗</span></a>
                <a class="github-link" href={project.repo} target="_blank" rel="noopener noreferrer" aria-label={`Open ${project.title} GitHub repository`}>GitHub ↗</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="project-approach">
      <div>
        <div class="section-kicker">HOW I APPROACH PROJECTS</div>
        <h2>From a research question<br />to a reproducible implementation.</h2>
      </div>
      <p>Projects connect problem formulation, algorithm design, implementation and evaluation. The emphasis is on transparent methods, useful documentation and practical learning.</p>
    </section>
  </main>
  <Footer />
</MainLayout>

<style>
  :global(html){scroll-behavior:smooth}
  .projects-page{--navy:#172554;--ink:#1e293b;--muted:#64748b;--blue:#4338ca;--line:#e2e8f0;max-width:1180px;margin:auto;padding:54px 28px 92px;color:var(--ink)}
  .projects-hero{padding:52px 0 64px;border-bottom:1px solid var(--line)}
  .eyebrow,.section-kicker{font-size:11px;font-weight:800;letter-spacing:.16em;color:var(--blue)}
  .eyebrow{display:flex;align-items:center;gap:10px}
  .eyebrow span{width:8px;height:8px;border-radius:50%;background:#6366f1;box-shadow:0 0 0 5px #eef2ff}
  h1{font-size:clamp(42px,6vw,68px);line-height:1.04;letter-spacing:-.055em;color:var(--navy);margin:28px 0 20px;font-weight:800}
  h1 em{font-style:normal;color:#4f46e5}
  .hero-copy{max-width:660px;font-size:17px;line-height:1.8;color:#475569}
  .hero-actions{display:flex;align-items:center;gap:26px;margin-top:30px;flex-wrap:wrap}
  .primary-link{background:#3730a3;color:white;text-decoration:none;padding:13px 18px;border-radius:9px;font-size:13px;font-weight:700}
  .primary-link span,.text-link span,.detail-link span{margin-left:8px}
  .text-link{color:#334155;text-decoration:none;font-size:13px;font-weight:700}
  .hero-note{margin-top:42px;color:#64748b;font-size:12px;display:flex;align-items:center;gap:9px}
  .note-dot{width:7px;height:7px;background:#10b981;border-radius:50%}
  .project-section{padding:66px 0 74px}
  .section-top{display:flex;justify-content:space-between;align-items:end;gap:24px;margin-bottom:28px}
  .section-top h2,.project-approach h2{font-size:clamp(27px,3vw,36px);letter-spacing:-.04em;color:var(--navy);margin:10px 0}
  .section-top p{margin:0;color:var(--muted);font-size:14px}
  .count{display:flex;align-items:center;gap:10px;color:#94a3b8;font-size:9px;letter-spacing:.12em;font-weight:800}
  .count strong{font-size:30px;letter-spacing:-.04em;color:#c7d2fe}
  .project-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px}
  .project-card{border:1px solid var(--line);border-radius:16px;overflow:hidden;background:white;transition:transform .2s ease,border-color .2s ease,box-shadow .2s ease}
  .project-card:hover{transform:translateY(-4px);border-color:#c7d2fe;box-shadow:0 16px 36px rgba(30,41,59,.07)}
  .visual-link{display:block;text-decoration:none}
  .project-visual{height:220px;background:#f8fafc;overflow:hidden;position:relative}
  .face-visual{height:100%;display:flex;align-items:center;justify-content:center;gap:18px;background:linear-gradient(135deg,#eef2ff,#f8fafc)}
  .face-visual img{width:31%;height:142px;object-fit:cover;border-radius:12px;box-shadow:0 8px 22px #1e293b20}
  .visual-arrow{font-size:23px;color:#6366f1;font-weight:700}
  .visual-caption{position:absolute;bottom:17px;left:20px;font-size:9px;font-weight:800;letter-spacing:.14em;color:#64748b}
  .abstract-visual{height:100%;position:relative;display:flex;align-items:center;justify-content:center;overflow:hidden}
  .geo-visual{background:radial-gradient(circle at center,#e0e7ff,#f8fafc 68%)}
  .orbit{position:absolute;border:1px solid #818cf8;border-radius:50%;transform:rotate(-24deg)}
  .orbit-one{width:250px;height:105px}.orbit-two{width:180px;height:180px;transform:rotate(48deg)}
  .geo-core{display:grid;place-items:center;width:66px;height:66px;border-radius:22px;background:#4338ca;color:white;font-size:28px;font-weight:800;box-shadow:0 12px 30px #4338ca35}
  .medical-visual{background:radial-gradient(circle at 50% 50%,#fce7f3,#fff1f2 50%,#fff 100%)}
  .cell{position:absolute;border-radius:50%;border:9px solid #e879a6;background:radial-gradient(circle,#9d174d 0 18%,#f9a8d4 20% 60%,#fce7f3 62%);box-shadow:0 10px 25px #9d174d20}
  .cell-one{width:74px;height:74px;transform:translate(-58px,-18px)}.cell-two{width:58px;height:58px;transform:translate(48px,25px)}.cell-three{width:42px;height:42px;transform:translate(65px,-48px)}
  .camera-visual{background:radial-gradient(circle at center,#dbeafe,#eff6ff 70%)}
  .camera-frame{width:130px;height:90px;border:3px solid #2563eb;border-radius:16px;display:grid;place-items:center;position:relative}
  .camera-frame:before{content:"";position:absolute;top:-13px;left:18px;width:34px;height:12px;border:3px solid #2563eb;border-bottom:0;border-radius:7px 7px 0 0}
  .camera-frame span{width:45px;height:45px;border:3px solid #2563eb;border-radius:50%;box-shadow:inset 0 0 0 9px #bfdbfe}
  .card-body{padding:22px 23px 20px}
  .card-meta{display:flex;justify-content:space-between;gap:10px;color:#6366f1;font-size:10px;font-weight:800;letter-spacing:.08em;text-transform:uppercase}
  .card-meta span:last-child{color:#94a3b8}
  .card-body h3{font-size:22px;color:var(--navy);letter-spacing:-.03em;margin:13px 0 9px}
  .card-body p{min-height:70px;font-size:13px;line-height:1.75;color:#64748b;margin:0}
  .tag-list{display:flex;flex-wrap:wrap;gap:7px;margin:18px 0 20px}
  .tag-list span{font-size:10px;font-weight:700;color:#475569;background:#f1f5f9;border:1px solid #e2e8f0;border-radius:5px;padding:6px 8px}
  .card-actions{border-top:1px solid #f1f5f9;padding-top:15px;display:flex;justify-content:space-between;align-items:center}
  .detail-link,.github-link{font-size:12px;font-weight:800;text-decoration:none}
  .detail-link{color:#4338ca}.github-link{color:#475569}
  .project-approach{border-top:1px solid var(--line);padding:54px 0 0;display:grid;grid-template-columns:1.2fr .8fr;gap:44px;align-items:center}
  .project-approach h2{line-height:1.2}
  .project-approach p{font-size:14px;line-height:1.85;color:#64748b;max-width:430px}
  a:focus-visible{outline:3px solid #818cf8;outline-offset:4px;border-radius:4px}
  @media(max-width:700px){.projects-page{padding:34px 20px 64px}.projects-hero{padding:34px 0 44px}.project-grid{grid-template-columns:1fr}.section-top{align-items:start}.count{display:none}.project-visual{height:190px}.project-approach{grid-template-columns:1fr;gap:10px}.card-body p{min-height:0}}
  @media(prefers-reduced-motion:reduce){:global(html){scroll-behavior:auto}.project-card{transition:none}}
</style>
