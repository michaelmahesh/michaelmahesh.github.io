
---
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const publications = [
  { year: 2026, title: 'Deep Kronecker NasNet-based AB-M Tree for Storage and Efficient Retrieval Model using Blockchain', authors: 'Mani S.V.J., Vijayan P., Ramachandran A., Michael Mahesh K.', journal: 'Iranian Journal of Science and Technology, Transactions of Electrical Engineering', snip: '0.778', quartile: 'Q2', publisher: 'Springer Nature', doi: '10.1007/s40998-026-01236-7', type: 'Journal Article' },
  { year: 2026, title: 'Deep learning technique for rice leaf disease classification and severity level identification via Hybrid ResConvolutional Neural Network', authors: 'R. Creesy, K. Michael Mahesh', journal: 'Scientific Reports', snip: '1.213', quartile: 'Q1', publisher: 'Nature Portfolio', doi: '10.1038/s41598-026-68755-5', type: 'Journal Article' },
  { year: 2026, title: 'Elk Skill Optimizer Enabled Joint Channel Access and Energy Management Algorithm for Dynamic Channel Allocation in WSN', authors: 'Michael Mahesh K., Ramachandran A., Vijayan P., Mani S.V.J.', journal: 'International Journal of Communication Systems', publisher: 'Wiley', doi: '10.1002/dac.70421', type: 'Journal Article' },
  { year: 2026, title: 'Heterogeneous Graph Convolution Cell Attention Network with Skill Optimization Based Jasmine Fragrance Detection', authors: 'E. D. Kanmani Ruby, M. Prabha, C. Ambika Bhuvaneswari, K. Michael Mahesh, G. Sivagurunathan', journal: 'Modeling, Simulation and Optimization: Proceedings of CoMSO 2024', publisher: 'Springer Nature', doi: '10.1007/978-981-95-4161-4_28', type: 'Book Chapter' },
  { year: 2025, title: 'MICH-Net: A Novel Deep Learning Architecture With African Fire Hawk Optimization for Steering Angle Prediction in an Advanced Driver Assistance System', authors: 'Michael Mahesh Kanakam, Veluchamy Sivasubbu, Karthi Selva Kumar, Muthukrishnan Athi', journal: 'IEEE Transactions on Intelligent Transportation Systems', snip: '2.758', quartile: 'Q1', publisher: 'IEEE', doi: '10.1109/TITS.2025.3623324', type: 'Journal Article' },
  { year: 2025, title: 'Multi-Modal Lung Cancer Detection Using Pyramidal Cascade Neuro-Fuzzy Fractional Network', authors: 'Ramachandran A., Michael Mahesh K., Vijayan Panneerselvam, S. V. J. Mani', journal: 'Cancer Investigation', snip: '0.419', quartile: 'Q3', publisher: 'Taylor & Francis', doi: '10.1080/07357907.2025.2520610', type: 'Journal Article' },
  { year: 2025, title: 'PMFHNet: Parallel Maxout Feed Harmonic Network for Road Anomaly Object Detection in ADAS Under Low Light Conditions', authors: 'U. Hari, K. Michael Mahesh, K. Gokulkannan, S. Veluchamy, Pradeepa Hari', journal: 'The Imaging Science Journal', snip: '0.422', quartile: 'Q2', publisher: 'Taylor & Francis', doi: '10.1080/13682199.2025.2599711', type: 'Journal Article' },
  { year: 2025, title: 'Deep Learning-Based Energy Prediction and Tangent Search Remora Optimization-Based Secure Multi-Path Data Communication Mechanism in WSN', authors: 'Muthukrishnan Athinarayanasamy, Karthi Selvakumar, Veluchamy Sivasubbu, Michael Mahesh Kanakam', journal: 'Network: Computation in Neural Systems', snip: '0.560', quartile: 'Q2', publisher: 'Taylor & Francis', doi: '10.1080/0954898X.2024.2393750', type: 'Journal Article' },
  { year: 2025, title: 'Decentralized Control Design for UAV Swarms Communication', authors: 'Manju S., Prabha M., Farithkhan A., Sivagurunathan G., Michael Mahesh K.', journal: 'Discover Applied Sciences', publisher: 'Springer Nature', doi: '10.1007/s42452-024-06408-w', type: 'Journal Article' },
  { year: 2025, title: 'Detecting Early-Stage Stress Levels Using EEG and Heart Rate Monitoring with Enhanced Sparse Fire Hawk Graph Probabilistic Spiking Attention Neural Network', authors: 'M. Prabha, E. D. K. Ruby, A. S. M. Priyadharson, K. M. Mahesh, S. R. Sabapathy, R. M. N.', journal: 'IEEE IDCIoT Conference', publisher: 'IEEE', doi: '10.1109/IDCIOT64235.2025.10915029', type: 'Conference Paper' },
  { year: 2024, title: 'Improving FANET Communication with a QoS Optimized Location-Aided Routing Protocol', authors: 'A. Farithkhan, E. D. K. Ruby, M. Prabha, S. Manju, R. Ramasamy, K. M. Mahesh', journal: 'IEEE ICOSEC Conference', publisher: 'IEEE', doi: '10.1109/ICOSEC61587.2024.10722211', type: 'Conference Paper' },
  { year: 2024, title: 'Next-Generation Wearable Antenna: Optimized Multi-Band Performance for Advanced Wireless Systems and Applications', journal: 'IEEE I4C Conference', publisher: 'IEEE', doi: '10.1109/I4C62240.2024.10748486', type: 'Conference Paper' },
  { year: 2023, title: 'HY-LSTM: New Time Series Deep Learning Architecture for Estimation of Pedestrian Time to Cross in ADAS', authors: 'Veluchamy S, Michael Mahesh K, Muthukrishnan R, Karthi S', journal: 'Journal of Visual Communication and Image Representation', snip: '1.056', quartile: 'Q1', publisher: 'Elsevier', doi: '10.1016/j.jvcir.2023.103982', type: 'Journal Article' },
  { year: 2023, title: 'DeepDrive: Braking Decision-Making Approach Using Optimized GAN and Deep CNN for ADAS', authors: 'S. Veluchamy, K. Michael Mahesh, Pon Bharathi A., Paul T. Sheeba', journal: 'Engineering Applications of Artificial Intelligence', snip: '1.888', quartile: 'Q1', publisher: 'Elsevier', doi: '10.1016/j.engappai.2023.106111', type: 'Journal Article' },
  { year: 2023, title: 'Design and Implementation of a Bio-Inspired Robot Arm: Machine Learning, Robot Vision', authors: 'A. Basi Reddy, K. Michael Mahesh, M. Prabha, R. Senthamil Selvan', journal: 'IEEE ICCAMS Conference', publisher: 'IEEE', doi: '10.1109/ICCAMS60113.2023.10526171', type: 'Conference Paper' },
  { year: 2022, title: 'RBorderNet: Rider Border Collie Optimization-Based Deep CNN for Road Scene Segmentation and Road Intersection Classification', journal: 'Digital Signal Processing', snip: '1.195', quartile: 'Q1', publisher: 'Elsevier', doi: '10.1016/j.dsp.2022.103626', type: 'Journal Article' },
  { year: 2021, title: 'Detection and Localization of Abnormalities in Surveillance Video Using Timerider-Based Neural Network', authors: 'S. Veluchamy, L. R. Karlmarx, K. Michael Mahesh', journal: 'The Computer Journal', snip: '0.856', quartile: 'Q2', publisher: 'Oxford University Press', doi: '10.1093/comjnl/bxab002', type: 'Journal Article' },
  { year: 2020, title: 'DeepJoint Segmentation for Classification of Severity-Levels of Glioma Tumour Using Multimodal MRI Images', authors: 'K. Michael Mahesh, J. Arokia Renjit', journal: 'IET Image Processing', snip: '0.853', quartile: 'Q2', publisher: 'Wiley / IET', doi: '10.1049/iet-ipr.2018.6682', type: 'Journal Article' },
  { year: 2020, title: 'Multiclassifier for Severity-Level Categorization of Glioma Tumors Using Multimodal MRI Brain Images', authors: 'K. Michael Mahesh, J. Arokia Renjit', journal: 'International Journal of Imaging Systems and Technology', snip: '0.902', quartile: 'Q2', publisher: 'Wiley', doi: '10.1002/ima.22357', type: 'Journal Article' },
  { year: 2020, title: 'Workflow Scheduling Using Improved Moth Swarm Optimization Algorithm in Cloud Computing', authors: 'K. Michael Mahesh', journal: 'Multimedia Research', publisher: 'Multimedia Research', doi: '10.46253/j.mr.v3i3.a5', type: 'Journal Article' },
  { year: 2018, title: 'Evolutionary Intelligence for Brain Tumor Recognition from MRI Images: A Critical Study and Review', authors: 'Michael Mahesh, J. Arokia Renjit', journal: 'Evolutionary Intelligence', publisher: 'Springer Nature', doi: '10.1007/s12065-018-0156-2', type: 'Journal Article' }
];

const publisherDomains: Record<string, string> = {
  'Springer Nature': 'springer.com',
  'Nature Portfolio': 'nature.com',
  'Wiley': 'wiley.com',
  'Wiley / IET': 'theiet.org',
  'IEEE': 'ieee.org',
  'Taylor & Francis': 'tandfonline.com',
  'Elsevier': 'elsevier.com',
  'Oxford University Press': 'oup.com',
};

const years = [...new Set(publications.map((item) => item.year))]
  .sort((a, b) => b - a);
---

<MainLayout
  title="Publications | Dr. K. Michael Mahesh"
  description="Research publications by Dr. K. Michael Mahesh in artificial intelligence, deep learning, computer vision, medical imaging and intelligent systems."
>
  <Header />

  <main>
    <section class="page-hero">
      <div class="container">
        <span class="eyebrow">RESEARCH OUTPUT</span>
        <h1>Research <span>Publications</span></h1>
        <p>
          A collection of research contributions in Artificial Intelligence,
          Deep Learning, Computer Vision, Medical Imaging, ADAS and intelligent systems.
        </p>

        <div class="hero-stats">
          <div>
            <strong>{publications.length}</strong>
            <span>Publications</span>
          </div>
          <div>
            <strong>{years.length}</strong>
            <span>Publication Years</span>
          </div>
          <div>
            <strong>2018–2026</strong>
            <span>Research Timeline</span>
          </div>
        </div>
      </div>
    </section>

    <section class="publication-area">
      <div class="container">
        <div class="section-heading">
          <div>
            <span class="section-label">BROWSE RESEARCH</span>
            <h2 class="section-title">Publication Archive</h2>
            <p class="section-description">
              Search publications by title, journal, publisher or DOI.
            </p>
          </div>
        </div>

        <div class="filters">
          <label class="search">
            <span aria-hidden="true">⌕</span>
            <input
              id="publicationSearch"
              type="search"
              placeholder="Search publications, journals, publishers..."
            />
          </label>

          <select id="yearFilter" aria-label="Filter by year">
            <option value="all">All Years</option>
            {years.map((year) => <option value={year}>{year}</option>)}
          </select>
        </div>

        <p class="result-count" id="resultCount">
          Showing {publications.length} publications
        </p>

        <div class="publication-list" id="publicationList">
          {publications.map((publication) => (
            <article
              class="publication-card"
              data-year={publication.year}
              data-search={`${publication.title} ${publication.journal} ${publication.publisher} ${publication.doi} ${publication.type}`.toLowerCase()}
            >
              <div class="publication-year">{publication.year}</div>

              <div class="publication-content">
                <h2>{publication.title}</h2>

                <p class="journal">{publication.journal}</p>

                <div class="publisher-logo">
                  {publisherDomains[publication.publisher] && (
                    <img
                      src={`https://www.google.com/s2/favicons?domain=${publisherDomains[publication.publisher]}&sz=64`}
                      alt=""
                      width="22"
                      height="22"
                      loading="lazy"
                    />
                  )}
                  <span>{publication.publisher}</span>
                </div>

                <div class="publication-badges">
                  <span class:list-badge={true}>
                    {publication.type === 'Journal Article'
                      ? 'Research Article'
                      : publication.type}
                  </span>

                  <span class="published-badge">
                    Published: {publication.year}
                  </span>

                  {publication.snip && (
                    <span class="snip-badge">
                      SNIP: {publication.snip}
                    </span>
                  )}

                  {publication.quartile && (
                    <span class="quartile-badge">
                      {publication.quartile}
                    </span>
                  )}
                </div>
              </div>

              <a
                class="doi-link"
                href={`https://doi.org/${publication.doi}`}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Open DOI for ${publication.title}`}
              >
                View DOI <span aria-hidden="true">↗</span>
              </a>
            </article>
          ))}
        </div>

        <div class="no-results" id="noResults" hidden>
          <strong>No publications found</strong>
          <p>Try another keyword or select a different year.</p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</MainLayout>

<script>
  const searchInput =
    document.querySelector<HTMLInputElement>('#publicationSearch');

  const yearFilter =
    document.querySelector<HTMLSelectElement>('#yearFilter');

  const cards = Array.from(
    document.querySelectorAll<HTMLElement>('.publication-card')
  );

  const resultCount =
    document.querySelector<HTMLElement>('#resultCount');

  const noResults =
    document.querySelector<HTMLElement>('#noResults');

  function filterPublications() {
    const term = searchInput?.value.trim().toLowerCase() ?? '';
    const year = yearFilter?.value ?? 'all';
    let visible = 0;

    cards.forEach((card) => {
      const matchesTerm = (card.dataset.search ?? '').includes(term);
      const matchesYear =
        year === 'all' || card.dataset.year === year;

      const show = matchesTerm && matchesYear;

      card.hidden = !show;

      if (show) visible += 1;
    });

    if (resultCount) {
      resultCount.textContent =
        `Showing ${visible} publication${visible === 1 ? '' : 's'}`;
    }

    if (noResults) {
      noResults.hidden = visible !== 0;
    }
  }

  searchInput?.addEventListener('input', filterPublications);
  yearFilter?.addEventListener('change', filterPublications);
</script>

<style>
  .page-hero {
    padding: 75px 0 58px;
    background:
      radial-gradient(circle at 85% 20%, #e0e7ff 0, transparent 28%),
      linear-gradient(180deg, #ffffff, #f8fafc);
    border-bottom: 1px solid #e2e8f0;
  }

  .eyebrow {
    display: inline-block;
    padding: 7px 12px;
    border: 1px solid #c7d2fe;
    border-radius: 30px;
    background: #eef2ff;
    color: #4f46e5;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.5px;
  }

  h1 {
    max-width: 850px;
    margin: 20px 0 15px;
    color: #172554;
    font: 800 clamp(38px, 5vw, 58px)/1.12 Manrope, sans-serif;
    letter-spacing: -2px;
  }

  h1 span {
    color: #4f46e5;
  }

  .page-hero p {
    max-width: 730px;
    color: #64748b;
    font-size: 15px;
    line-height: 1.8;
  }

  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 28px;
  }

  .hero-stats div {
    min-width: 135px;
    padding: 12px 16px;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    background: #ffffff;
  }

  .hero-stats strong,
  .hero-stats span {
    display: block;
  }

  .hero-stats strong {
    color: #172554;
    font: 800 20px Manrope, sans-serif;
  }

  .hero-stats span {
    color: #64748b;
    font-size: 11px;
  }

  .publication-area {
    padding: 55px 0 85px;
    background: #f8fafc;
  }

  .section-heading {
    margin-bottom: 25px;
  }

  .section-description {
    margin-top: 8px;
  }

  /* Search and year filter */

  .filters {
    display: grid;
    grid-template-columns: 1fr 180px;
    gap: 13px;
    margin-bottom: 18px;
  }

  .search {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 48px;
    padding: 0 15px;
    border: 1px solid #e2e8f0;
    border-radius: 11px;
    background: #ffffff;
    color: #64748b;
  }

  .search span {
    font-size: 23px;
  }

  .search input {
    width: 100%;
    border: 0;
    outline: 0;
    background: transparent;
    color: #334155;
    font: inherit;
    font-size: 13px;
  }

  .filters select {
    min-width: 0;
    padding: 0 13px;
    border: 1px solid #e2e8f0;
    border-radius: 11px;
    background: #ffffff;
    color: #334155;
    font: inherit;
    font-size: 13px;
  }

  .search:focus-within,
  .filters select:focus {
    outline: 3px solid #e0e7ff;
    border-color: #818cf8;
  }

  .result-count {
    margin: 0 0 14px;
    color: #64748b;
    font-size: 12px;
    font-weight: 700;
  }

  /* Publication cards */

  .publication-list {
    display: grid;
    gap: 14px;
  }

  .publication-card {
    display: grid;
    grid-template-columns: 65px minmax(0, 1fr) auto;
    align-items: start;
    gap: 19px;
    padding: 23px 24px;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    background: #ffffff;
    transition: transform .22s ease, box-shadow .22s ease,
      border-color .22s ease;
  }

  .publication-card:hover {
    transform: translateY(-2px);
    border-color: #c7d2fe;
    box-shadow: 0 12px 30px rgba(23, 37, 84, .06);
  }

  .publication-card[hidden] {
    display: none;
  }

  .publication-year {
    padding-top: 2px;
    color: #5545e8;
    font: 800 22px Manrope, sans-serif;
    letter-spacing: -1px;
  }

  .publication-content h2 {
    margin: 0 0 9px;
    color: #172554;
    font: 750 16px/1.5 Manrope, sans-serif;
  }

  .journal {
    margin: 0 0 10px;
    color: #475569;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.6;
  }

  /* Publisher logo */

  .publisher-logo {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 15px;
    color: #64748b;
    font-size: 11px;
    font-weight: 600;
  }

  .publisher-logo img {
    width: 22px;
    height: 22px;
    object-fit: contain;
    border-radius: 4px;
  }

  /* Minimal metadata badges */

  .publication-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .list-badge,
  .published-badge,
  .snip-badge,
  .quartile-badge {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    padding: 6px 12px;
    border: 1px solid;
    border-radius: 12px;
    font-size: 11px;
    font-weight: 750;
    line-height: 1.3;
  }

  .list-badge {
    border-color: #fed7aa;
    background: #fff7ed;
    color: #ea580c;
  }

  .published-badge {
    border-color: #dbe4f0;
    background: #f8fafc;
    color: #64748b;
  }

  .snip-badge {
    border-color: #c7d2fe;
    background: #eef2ff;
    color: #4338ca;
  }

  .quartile-badge {
    border-color: #bbf7d0;
    background: #f0fdf4;
    color: #15803d;
  }

  /* DOI button */

  .doi-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    white-space: nowrap;
    padding: 9px 12px;
    border: 1px solid #c7d2fe;
    border-radius: 9px;
    background: #eef2ff;
    color: #4338ca;
    font-size: 11px;
    font-weight: 800;
    text-decoration: none;
    transition: .2s ease;
  }

  .doi-link:hover {
    border-color: #4f46e5;
    background: #4f46e5;
    color: #ffffff;
  }

  /* No search results */

  .no-results {
    margin-top: 15px;
    padding: 35px;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    background: #ffffff;
    color: #64748b;
    text-align: center;
  }

  .no-results strong {
    color: #172554;
  }

  /* Tablet */

  @media (max-width: 800px) {
    .publication-card {
      grid-template-columns: 55px minmax(0, 1fr);
      gap: 12px;
      padding: 20px;
    }

    .doi-link {
      grid-column: 2;
      width: fit-content;
    }

    .filters {
      grid-template-columns: 1fr 150px;
    }
  }

  /* Mobile */

  @media (max-width: 520px) {
    .page-hero {
      padding: 55px 0 42px;
    }

    .publication-area {
      padding: 40px 0 60px;
    }

    .publication-card {
      grid-template-columns: 1fr;
      gap: 12px;
      padding: 19px;
    }

    .publication-year {
      font-size: 20px;
    }

    .publication-content h2 {
      font-size: 15px;
    }

    .doi-link {
      grid-column: 1;
    }

    .filters {
      grid-template-columns: 1fr;
    }

    .filters select {
      height: 45px;
    }

    .list-badge,
    .published-badge,
    .snip-badge,
    .quartile-badge {
      min-height: 32px;
      padding: 6px 10px;
      font-size: 10px;
    }
  }
</style>
